{
    "compilerOptions": {
      "target": "ES2022",
      "module": "Node16",
      "moduleResolution": "Node16",
      "outDir": "./build",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"],
    "paths": {
      "@/*": ["./src/*"],
      "@mcp/*": ["./src/mcp/*"],
      "@tools/*": ["./src/mcp/tools/*"],
      "@util/*": ["./src/util/*"]
    }
  }